---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Shown small and orange along the edges, like a real film edge code. */
  edgeCode?: string;
}

const { image, alt, edgeCode = 'KODAK 400TX' } = Astro.props;
---

<figure class="film">
  <div class="edge edge-top">
    <span class="sprockets"></span>
    <span class="code">{edgeCode}</span>
  </div>

  <div class="window">
    <Image
      src={image}
      alt={alt}
      widths={[420, 700, 1000]}
      sizes="(max-width: 900px) 90vw, 34vw"
      loading="lazy"
    />
  </div>

  <div class="edge edge-bottom">
    <span class="sprockets"></span>
    <span class="code">25 &rarr; 25A</span>
  </div>
</figure>

<style>
  .film {
    --film-base: #1a1512;
    --sprocket: #d6cfc2;
    --edge-ink: #f07a35;
    --hole: 15px;
    --pitch: 27px;

    margin: 0;
    width: 100%;
    max-width: 28rem;
    background: var(--film-base);
    padding: 0.3rem 0;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
  }

  .edge {
    position: relative;
    height: 1.5rem;
    display: flex;
    align-items: center;
  }

  /* The perforations. A repeating gradient rather than forty elements. */
  .sprockets {
    position: absolute;
    inset: 0 5.5rem 0 0;
    background-image: repeating-linear-gradient(
      to right,
      var(--sprocket) 0 var(--hole),
      transparent var(--hole) var(--pitch)
    );
    background-size: var(--pitch) 0.78rem;
    background-position: 0.55rem center;
    background-repeat: repeat-x;
  }

  .edge-bottom .sprockets {
    inset: 0 0 0 5.5rem;
    background-position: right 0.55rem center;
  }

  .code {
    position: relative;
    z-index: 1;
    margin-left: auto;
    padding-right: 0.7rem;
    color: var(--edge-ink);
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  .edge-bottom .code {
    margin-left: 0.7rem;
    margin-right: auto;
    padding-right: 0;
  }

  .window {
    position: relative;
    aspect-ratio: 3 / 2;
    margin-inline: 0.55rem;
    background: #0a0908;
    overflow: hidden;
    /* the thin line between exposures on a real strip */
    outline: 1px solid rgba(214, 207, 194, 0.16);
    outline-offset: 2px;
  }

  .window :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
