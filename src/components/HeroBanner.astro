---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;

/**
 * The banner takes the photograph's own proportions, so the whole frame is
 * always visible — no wingtips cropped off at any screen size. It's capped
 * so it can't swallow the entire screen on a wide monitor.
 */
const ratio = image ? `${image.width} / ${image.height}` : '16 / 9';
---

<section class="banner" style={`--ratio: ${ratio};`} aria-label="Header photograph">
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[900, 1400, 1900, 2400, 2730]}
        sizes="100vw"
        quality={90}
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <span class="placeholder label">
        Header photograph goes here — set <code>heroPhoto</code> in src/data/site.json
      </span>
    )
  }
</section>

<style>
  .banner {
    /* The banner is exactly the photograph's own shape at full page width.
       Because the box matches the image, nothing is cropped and nothing is
       letterboxed — the whole frame, edge to edge, at every screen size. */
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--c-ground);
  }

  .banner :global(img) {
    width: 100%;
    height: 100%;
    /* contain, not cover: the entire photograph, never a crop */
    object-fit: contain;
    object-position: center;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--gutter);
    text-align: center;
  }

  .placeholder code { color: var(--c-accent); }
</style>
