---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /**
   * Which part of the photograph stays visible in the banner. The frame is
   * much wider than the photograph is tall, so something has to be cropped.
   * A lower percentage shows more of the top of the photograph, which pushes
   * the subject further down the frame. Set it in src/data/site.json.
   */
  position?: string;
}

const { image, alt, position = 'center 50%' } = Astro.props;
---

<section class="banner" aria-label="Header photograph">
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[800, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${position};`}
      />
    ) : (
      <span class="placeholder label">
        Header photograph goes here — set <code>heroPhoto</code> in src/data/site.json
      </span>
    )
  }
</section>

<style>
  .banner {
    position: relative;
    height: clamp(15rem, 46svh, 30rem);
    overflow: hidden;
    background: var(--c-surface-2);
  }

  .banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--gutter);
    text-align: center;
  }

  .placeholder code { color: var(--c-accent); }
</style>
