---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  tagline?: string;
}

const { image, alt, tagline } = Astro.props;
---

<section class="banner" aria-label="Header photograph">
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[800, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <span class="placeholder label">
        Header photograph goes here — set <code>heroPhoto</code> in src/data/site.json
      </span>
    )
  }

  <div class="scrim"></div>
  {tagline && <p class="tagline">{tagline}</p>}
</section>

<style>
  .banner {
    position: relative;
    height: clamp(15rem, 46svh, 30rem);
    overflow: hidden;
    background: var(--c-surface-2);
  }

  .banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--gutter);
    text-align: center;
  }

  .placeholder code { color: var(--c-accent); }

  /* Keeps the tagline legible over any photograph. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(11, 11, 12, 0) 45%,
      rgba(11, 11, 12, 0.6) 100%
    );
  }

  .tagline {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--s-5);
    margin: 0;
    max-width: 26ch;
    font-family: var(--f-display);
    font-size: clamp(var(--t-2), 3.4vw, var(--t-3));
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-tight);
    text-wrap: balance;
  }
</style>
