---
import site from '../data/site.json';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/">{site.wordmark}</a>
    <nav aria-label="Main">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--c-nav-bg);
    color: var(--c-nav-ink);
    padding-inline: var(--gutter);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--c-nav-line);
  }


  .inner {
    max-width: var(--w-page);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
  }

  .wordmark {
    font-family: var(--f-display);
    font-size: clamp(var(--t-1), 2.6vw, var(--t-2));
    letter-spacing: var(--tr-tight);
    color: var(--c-nav-ink);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--t--1);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--c-nav-soft);
  }

  nav a { transition: color var(--dur) var(--ease); }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--c-nav-accent); }

  .site-header :global(a:focus-visible) {
    outline: 2px solid var(--c-nav-accent);
    outline-offset: 3px;
  }
</style>
