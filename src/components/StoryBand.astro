---
import FilmStrip from './FilmStrip.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image: ImageMetadata;
  alt: string;
  edgeCode?: string;
  /** Odd-numbered bands put the film strip on the right instead. */
  flip?: boolean;
}

const { title, image, alt, edgeCode, flip = false } = Astro.props;
---

<section class:list={['band', { flip }]}>
  <div class="pane pane-film">
    <FilmStrip image={image} alt={alt} edgeCode={edgeCode} />
  </div>

  <div class="pane pane-text">
    <div class="text-inner">
      <h2>{title}</h2>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    border-top: 1px solid var(--c-hairline);
  }

  @media (min-width: 900px) {
    .band { grid-template-columns: 1fr 1fr; }
    .band.flip .pane-film { order: 2; }
  }

  /* The strip sits in space rather than filling the half, which is what
     makes it read as an object on a table instead of a background. */
  .pane-film {
    display: grid;
    place-items: center;
    padding: var(--s-8) var(--gutter);
  }

  .pane-text {
    display: grid;
    align-content: center;
    padding: var(--s-7) var(--gutter) var(--s-8);
  }

  .text-inner { max-width: var(--w-prose); }

  .pane-text .prose {
    margin-top: var(--s-5);
    color: var(--c-ink-soft);
  }
</style>
