---
/**
 * The link at the foot of the home page. Clicking it sends a small flock of
 * simple white birds up off the screen before the gallery loads.
 *
 * The birds are decorative: they're aria-hidden, they never block the click,
 * and anyone who prefers reduced motion goes straight to the gallery with no
 * animation at all.
 */
---

<section class="cta">
  <a href="/gallery/" class="gallery-link" data-flock>See the whole gallery &rarr;</a>
</section>

<script>
  const link = document.querySelector<HTMLAnchorElement>('a[data-flock]');

  if (link) {
    const BIRDS = 9;
    const FLIGHT = 1050; // ms — long enough to read, short enough not to nag

    link.addEventListener('click', (event) => {
      // Let modified clicks (new tab, etc.) behave normally.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      event.preventDefault();

      const rect = link.getBoundingClientRect();
      const layer = document.createElement('div');
      layer.className = 'flock-layer';
      layer.setAttribute('aria-hidden', 'true');

      for (let i = 0; i < BIRDS; i++) {
        const bird = document.createElement('span');
        bird.className = 'bird';

        // Fan out from the link, then away up and to the sides.
        const spread = (i / (BIRDS - 1) - 0.5) * 2;        // -1 → 1
        const scale = 0.55 + ((i * 7) % 10) / 14;           // varied sizes
        const driftX = spread * (140 + ((i * 37) % 120));
        const riseY = -(320 + ((i * 53) % 260));
        const delay = (i * 45) % 320;
        const flap = 150 + ((i * 29) % 90);

        bird.style.setProperty('--x0', `${rect.left + rect.width / 2 + spread * 40}px`);
        bird.style.setProperty('--y0', `${rect.top + rect.height / 2}px`);
        bird.style.setProperty('--dx', `${driftX}px`);
        bird.style.setProperty('--dy', `${riseY}px`);
        bird.style.setProperty('--s', `${scale}`);
        bird.style.setProperty('--d', `${delay}ms`);
        bird.style.setProperty('--flap', `${flap}ms`);

        bird.innerHTML =
          '<svg viewBox="0 0 40 14" width="40" height="14" fill="none" ' +
          'stroke="currentColor" stroke-width="2" stroke-linecap="round">' +
          '<path d="M1 9 Q10 1 20 8" /><path d="M20 8 Q30 1 39 9" />' +
          '</svg>';

        layer.appendChild(bird);
      }

      document.body.appendChild(layer);
      window.setTimeout(() => {
        window.location.href = link.href;
      }, FLIGHT);
    });
  }
</script>

<style is:global>
  .flock-layer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    overflow: hidden;
  }

  .flock-layer .bird {
    position: absolute;
    left: 0;
    top: 0;
    color: #fff;
    transform: translate3d(var(--x0), var(--y0), 0) scale(var(--s));
    animation: bird-away 1000ms cubic-bezier(0.3, 0, 0.35, 1) var(--d) forwards;
    will-change: transform, opacity;
  }

  .flock-layer .bird svg {
    display: block;
    transform-origin: 50% 70%;
    animation: bird-flap var(--flap) ease-in-out infinite alternate;
  }

  @keyframes bird-away {
    0%   { opacity: 0; transform: translate3d(var(--x0), var(--y0), 0) scale(calc(var(--s) * 0.6)); }
    12%  { opacity: 1; }
    75%  { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate3d(
        calc(var(--x0) + var(--dx)),
        calc(var(--y0) + var(--dy)),
        0
      ) scale(var(--s));
    }
  }

  @keyframes bird-flap {
    from { transform: scaleY(1); }
    to   { transform: scaleY(0.35); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flock-layer { display: none; }
  }
</style>

<style>
  .cta {
    border-top: 1px solid var(--c-hairline);
    padding: var(--s-8) var(--gutter);
    text-align: center;
  }

  .gallery-link {
    font-family: var(--f-display);
    font-size: clamp(var(--t-2), 3.6vw, var(--t-3));
    letter-spacing: var(--tr-tight);
  }

  .gallery-link:hover { color: var(--c-accent); }
</style>
