---
/**
 * The link at the foot of the home page.
 *
 * When this section scrolls properly into view, a flock of sketched birds
 * lifts off and flutters away up and to the left. No click required — it's
 * a reward for reaching the bottom of the page.
 *
 * The birds are decorative: aria-hidden, the layer never blocks a click, and
 * nothing happens at all for anyone who prefers reduced motion.
 */
---

<section class="cta" data-flock-zone>
  <a href="/gallery/" class="gallery-link"><span data-launch>See</span> the whole gallery &rarr;</a>
</section>

<script>
  const zone = document.querySelector<HTMLElement>('[data-flock-zone]');

  if (zone && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const BIRDS = 17;
    const BIRD_W = 62;
    const BIRD_H = 26;
    const RISE = 3000;   // how long one bird's flight lasts
    const SPREAD = 620;  // the ragged wave of takeoffs
    // The layer must outlive the very last bird, or the slowest ones get cut
    // off mid-air and it looks like they stopped and started again.
    const FLIGHT = RISE + SPREAD + 400;

    // Bird seen from behind: two tapered wings in a wide, shallow V.
    const BIRD_SVG = `
<svg viewBox="0 0 80 34" width="62" height="26" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path class="wing wl" d="M40 25 C 34 19, 24 12, 6 9 C 16 16, 28 21, 39 26 Z"/>
  <path class="wing wr" d="M41 25 C 47 19, 57 12, 75 9 C 65 16, 53 21, 42 26 Z"/>
</svg>`;

    let flying = false;

    function launch() {
      if (flying) return;
      flying = true;

      const rect = zone.getBoundingClientRect();
      const layer = document.createElement('div');
      layer.className = 'flock-layer';
      layer.setAttribute('aria-hidden', 'true');

      // They come up off the word "See", not the middle of the line.
      const word = zone.querySelector('[data-launch]');
      const anchor = (word || zone.querySelector('a') || zone).getBoundingClientRect();

      for (let i = 0; i < BIRDS; i++) {
        const bird = document.createElement('span');
        bird.className = 'bird';
        const inner = document.createElement('span');
        inner.className = 'bird-y';
        const t = i / (BIRDS - 1);

        // Size is set as a real width rather than a transform. A scale() on
        // the parent would also scale the child's translation, so the small
        // birds would travel proportionally less far and stall mid-screen.
        const scale = 0.5 + ((i * 17) % 14) / 15;
        const w = Math.round(BIRD_W * scale);
        const h = Math.round(BIRD_H * scale);

        // A tight knot right on the word "See". `left`/`top` place a bird's
        // top-left corner, so pull back by half its size to sit the bird
        // itself on the word rather than hanging down and to the right of it.
        const startX = anchor.right - w / 2 + (((i * 37) % 26) - 13);
        const startY = anchor.top + anchor.height / 2 - h / 2 + (((i * 53) % 22) - 11);

        // Every bird must clear the top of the window under its own steam —
        // no fading out partway. Distance is measured from where it starts.
        const riseY = -(startY + h + 140 + ((i * 61) % 260));
        const driftX = -(70 + t * 260 + ((i * 43) % 120));

        // Startled flocks don't leave together — they go up in a ragged wave,
        // a few first and the rest tumbling after.
        const burst = i < 4 ? i * 35 : 120 + ((i * 137) % SPREAD);

        bird.style.left = `${startX}px`;
        bird.style.top = `${startY}px`;
        bird.style.setProperty('--dx', `${driftX}px`);
        bird.style.setProperty('--dy', `${riseY}px`);
        bird.style.setProperty('--w', `${w}px`);
        bird.style.setProperty('--d', `${burst}ms`);
        bird.style.setProperty('--rise', `${RISE}ms`);
        // Wingbeat: fast and clattering, never quite in time with its neighbours.
        bird.style.setProperty('--flap', `${95 + ((i * 43) % 55)}ms`);
        bird.style.setProperty('--bank', `${1500 + ((i * 211) % 900)}ms`);
        bird.style.setProperty('--tilt', `${-4 - ((i * 13) % 12)}deg`);
        // Each bird holds its wings a little differently, as in a real flock.
        bird.style.setProperty('--wb', `${-9 + ((i * 29) % 20)}`);

        inner.innerHTML = BIRD_SVG;
        bird.appendChild(inner);
        layer.appendChild(bird);
      }

      document.body.appendChild(layer);
      window.setTimeout(() => layer.remove(), FLIGHT);
    }

    // Once per page load, the first time the section is properly in view —
    // not the moment it peeks over the edge. Then it stops watching, so it
    // never fires a second flock over the top of the first.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
            launch();
            io.disconnect();
          }
        }
      },
      { threshold: [0, 0.6] }
    );

    io.observe(zone);
  }
</script>

<style is:global>
  .flock-layer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    overflow: hidden;
  }

  .flock-layer .bird {
    position: absolute;
    opacity: 0;
    /* X eases out hard: the startled burst, then coasting */
    animation:
      fly-x var(--rise) cubic-bezier(0.10, 0.68, 0.30, 1) var(--d) forwards,
      bird-in 90ms linear var(--d) forwards;
    will-change: transform, opacity;
  }

  /* Y is a separate element on a different curve — that mismatch is what
     bends the flight into an arc instead of a straight diagonal. */
  .flock-layer .bird-y {
    display: block;
    color: #fff;
    animation:
      fly-y var(--rise) cubic-bezier(0.18, 0.55, 0.32, 1) var(--d) forwards,
      bank var(--bank) ease-in-out var(--d) infinite alternate;
    will-change: transform;
  }

  @keyframes fly-x {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(var(--dx), 0, 0); }
  }

  @keyframes fly-y {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, var(--dy), 0); }
  }

  @keyframes bank {
    from { rotate: var(--tilt); }
    to   { rotate: calc(var(--tilt) - 9deg); }
  }

  /* Only a fade in, so they don't pop into being. They exit by flying off
     the top of the window, never by dissolving. */
  @keyframes bird-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Wings pivot at the shoulder, in the SVG's own coordinate space. */
  .flock-layer .bird svg {
    display: block;
    width: var(--w);
    height: auto;
  }

  .flock-layer .bird .wing {
    transform-box: view-box;
    transform-origin: 40px 25px;
  }

  .flock-layer .bird .wl {
    animation: flap-l var(--flap) cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }
  .flock-layer .bird .wr {
    animation: flap-r var(--flap) cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }

  /* A deep beat — pigeons clatter, they don't flutter politely. */
  @keyframes flap-l {
    from { transform: rotate(calc((var(--wb) - 26) * 1deg)); }
    to   { transform: rotate(calc((var(--wb) + 24) * 1deg)); }
  }
  @keyframes flap-r {
    from { transform: rotate(calc((var(--wb) - 26) * -1deg)); }
    to   { transform: rotate(calc((var(--wb) + 24) * -1deg)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flock-layer { display: none; }
  }
</style>

<style>
  .cta {
    border-top: 1px solid var(--c-hairline);
    padding: var(--s-8) var(--gutter);
    text-align: center;
  }

  .gallery-link {
    font-family: var(--f-display);
    font-size: clamp(var(--t-2), 3.6vw, var(--t-3));
    letter-spacing: var(--tr-tight);
  }

  .gallery-link:hover { color: var(--c-accent); }
</style>
