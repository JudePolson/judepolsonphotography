---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import StoryBand from '../components/StoryBand.astro';
import site from '../data/site.json';

// One photograph at the top. Change which one in src/data/site.json → heroPhoto.
const hero = await getEntry('photos', site.heroPhoto);
if (!hero) {
  throw new Error(
    `src/data/site.json names heroPhoto "${site.heroPhoto}", which doesn't exist in src/content/photos/.`
  );
}

const stories = (await getCollection('stories', (s) => s.data.published)).sort(
  (a, b) => a.data.order - b.data.order
);

// Each story names a photo by its filename; look it up rather than duplicating the file.
const allPhotos = await getCollection('photos');
const byId = new Map(allPhotos.map((p) => [p.id, p]));

const rendered = await Promise.all(
  stories.map(async (story) => {
    const photo = byId.get(story.data.photo);
    if (!photo) {
      throw new Error(
        `Story "${story.id}" points at photo "${story.data.photo}", which doesn't exist in src/content/photos/.`
      );
    }
    return { story, photo, Content: (await render(story)).Content };
  })
);
---

<Base isHome>
  <HeroBanner
    image={hero.data.image}
    alt={hero.data.alt ?? hero.data.title}
    position={site.heroPosition}
  />

  <div id="stories">
    {
      rendered.map(({ story, photo, Content }, i) => (
        <StoryBand
          title={story.data.title}
          image={photo.data.image}
          imageAlt={photo.data.alt ?? photo.data.title}
          flip={i % 2 === 1}
        >
          <Content />
        </StoryBand>
      ))
    }
  </div>

  <section class="cta">
    <a href="/gallery">See the whole gallery &rarr;</a>
  </section>
</Base>

<style>
  .cta {
    border-top: 1px solid var(--c-hairline);
    padding: var(--s-8) var(--gutter);
    text-align: center;
  }

  .cta a {
    font-family: var(--f-display);
    font-size: clamp(var(--t-2), 3.6vw, var(--t-3));
    letter-spacing: var(--tr-tight);
  }

  .cta a:hover { color: var(--c-accent); }
</style>
