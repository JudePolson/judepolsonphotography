---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroBanner from '../components/HeroBanner.astro';
import StoryBand from '../components/StoryBand.astro';
import GalleryLink from '../components/GalleryLink.astro';
import site from '../data/site.json';

// One photograph at the top. Change which one in src/data/site.json → heroPhoto.
const hero = await getEntry('photos', site.heroPhoto);
if (!hero) {
  throw new Error(
    `src/data/site.json names heroPhoto "${site.heroPhoto}", which doesn't exist in src/content/photos/.`
  );
}

const stories = (await getCollection('stories', (s) => s.data.published)).sort(
  (a, b) => a.data.order - b.data.order
);

// Each story names a photo by its filename; look it up rather than duplicating the file.
const allPhotos = await getCollection('photos');
const byId = new Map(allPhotos.map((p) => [p.id, p]));

const rendered = await Promise.all(
  stories.map(async (story) => {
    const frames = story.data.photos.map((id) => {
      const photo = byId.get(id);
      if (!photo || !photo.data.image) {
        throw new Error(
          `Story "${story.id}" lists photo "${id}", which doesn't exist in src/content/photos/ (or has no image yet).`
        );
      }
      return { image: photo.data.image, alt: photo.data.alt ?? photo.data.title };
    });
    return { story, frames, Content: (await render(story)).Content };
  })
);
---

<Base isHome>
  <HeroBanner image={hero.data.image} alt={hero.data.alt ?? hero.data.title} />

  <div id="stories">
    {
      rendered.map(({ story, frames, Content }, i) => (
        <StoryBand
          title={story.data.title}
          frames={frames}
          edgeCode={story.data.edgeCode}
          flip={i % 2 === 1}
        >
          <Content />
        </StoryBand>
      ))
    }
  </div>

  <GalleryLink />
</Base>

