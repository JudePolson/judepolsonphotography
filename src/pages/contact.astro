---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Contact" description={`How to get in touch about ${site.photographerFirstName}'s photographs.`}>
  <section class="shell wrap">
    <h1>Get in touch</h1>
    <div class="prose">
      <p>PLACEHOLDER — a sentence or two in Jude's voice about reaching out.</p>
      <p>
        Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>, which
        goes to {site.contact.displayName}.
      </p>
    </div>
  </section>
</Base>

<style>
  .wrap { padding-block: var(--s-8); }
  .prose { margin-top: var(--s-5); color: var(--c-ink-soft); }
</style>
